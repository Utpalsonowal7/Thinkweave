NODE_ENV=development
PORT=8080
DATABASE_URL=postgresql://postgres:password@localhost:5432/thinkweave?schema=public
REDIS_URL=redis://localhost:6379
GEMINI_API_KEY=
# OAuth app credentials and exact callback URLs; leave blank until configured.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/google/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:8080/api/v1/auth/oauth/github/callback
OAUTH_SUCCESS_REDIRECT=http://localhost:5173/
# Exact trusted browser origin; configure HTTPS outside local development.
APP_ORIGIN=http://localhost:5173
# Brevo transactional email; sender must be verified in Brevo.
BREVO_API_KEY=
EMAIL_FROM=
# Base URL for frontend links, served by a page that reads the fragment and POSTs the token.
APP_URL=http://localhost:5173
# At least 32 random bytes encoded as 64 hex characters; never commit the real value.
JWT_ACCESS_SECRET=
